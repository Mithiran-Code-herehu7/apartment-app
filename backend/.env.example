# Environment variables for ApartmentSkills Backend

# Deployment Environment
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apartmentskills?schema=public"

# Security
# Required in production. Keep this secret safe!
JWT_SECRET="your_super_secret_jwt_key_here"

# Third-Party API Keys (Stubbed for now)
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="your_razorpay_secret"
